{
  "version": "0.1.4",
  "name": "LumiLens Updated",
  "identifier": "lumilens_updated",
  "author": "shirunick",
  "github": "https://github.com/CloudCompile/lumilens-updated",
  "homepage": "https://github.com/CloudCompile/lumilens-updated",
  "description": "Browse, explore, create, and curate character cards with Ari: Quick View, card creation, Card Picker, and Tinder swipe modes.",
  "permissions": ["generation", "characters", "images", "image_gen", "chats"],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "storage_seed_files": [
    {
      "from": "assets/ari.png",
      "to": "ari.png",
      "required": true,
      "overwrite": true
    }
  ]
}
